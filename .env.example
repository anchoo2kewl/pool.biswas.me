# Copy to .env and fill in. Never commit .env.
POOL_ENV=development
POOL_ADDR=:8080
POOL_APP_URL=http://localhost:8080
POOL_DB_PATH=./data/pool.db
POOL_DATA_DIR=./data

# open | invite | closed
POOL_REGISTRATION=open

# Seeds the first account on an empty database.
POOL_ADMIN_EMAIL=
POOL_ADMIN_PASSWORD=

# Any OpenAI-compatible endpoint. Users may override per account.
POOL_AI_BASE_URL=https://integrate.api.nvidia.com/v1
POOL_AI_API_KEY=
POOL_AI_MODEL=meta/llama-3.2-90b-vision-instruct

# Reading a photographed test sheet needs a vision model, which is rarely the
# same one used for text. Left empty, photos go to POOL_AI_MODEL, which works
# on NIM and OpenRouter and fails at the provider on a text-only endpoint.
POOL_AI_VISION_MODEL=

# Whether the keys above serve everyone who signs up, or only the admin
# account. Off by default: a model key costs its owner money per request, and
# on a public instance every visitor would be spending it.
POOL_AI_SHARED=false

# Or configure a fallback chain the go-ai way: primary first, then backups,
# stopping at the first gap. These take precedence over POOL_AI_* above.
# AI_1_PROVIDER=nvidia
# AI_1_MODEL=meta/llama-3.2-90b-vision-instruct
# AI_1_API_KEY=
# AI_2_PROVIDER=deepseek
# AI_2_MODEL=deepseek-v4-flash
# AI_2_API_KEY=
# AIV_1_* configures the vision chain the same way.

# Sign-in providers. Each appears only when both values are set.
# Callbacks: ${POOL_APP_URL}/auth/google/callback and /auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GH_CLIENT_ID=
GH_CLIENT_SECRET=

# Stable random string. Without it, sign-ins break across restarts.
OAUTH_STATE_SECRET=
